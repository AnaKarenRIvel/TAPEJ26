<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="420.0" prefWidth="250.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="practica6.practica6controller">
   <children>
      <Label layoutX="34.0" layoutY="16.0" text="Elige un sistema operativo" />
      <RadioButton fx:id="rbWin" layoutX="34.0" layoutY="50.0" mnemonicParsing="false" selected="true" text="Windows">
         <toggleGroup>
            <ToggleGroup fx:id="buttonGroup1" />
         </toggleGroup>
      </RadioButton>
      <RadioButton fx:id="rbLnx" layoutX="34.0" layoutY="80.0" mnemonicParsing="false" text="Linux" toggleGroup="$buttonGroup1" />
      <RadioButton fx:id="rbMac" layoutX="34.0" layoutY="110.0" mnemonicParsing="false" text="Mac" toggleGroup="$buttonGroup1" />
      
      <Label layoutX="23.0" layoutY="155.0" text="Uso de la PC" />
      <CheckBox fx:id="chPrg" layoutX="33.0" layoutY="185.0" mnemonicParsing="false" text="Programación" />
      <CheckBox fx:id="chGrf" layoutX="33.0" layoutY="215.0" mnemonicParsing="false" text="Diseño Gráfico" />
      <CheckBox fx:id="chAdm" layoutX="33.0" layoutY="245.0" mnemonicParsing="false" text="Administración" />
      
      <Label layoutX="29.0" layoutY="285.0" text="Horas que dedicas en la PC" />
      <Slider fx:id="sdHrs" layoutX="25.0" layoutY="315.0" max="24.0" prefWidth="200.0" value="8.0" />
      <Label fx:id="lbHrs" alignment="CENTER" layoutX="113.0" layoutY="340.0" prefWidth="23.0" text="8" />
      
      <Button fx:id="btnGuardar" layoutX="92.0" layoutY="375.0" mnemonicParsing="false" onAction="#btnGuardarActionPerformed" text="Guardar" />
   </children>
</AnchorPane>